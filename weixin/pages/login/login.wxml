<view class="page">
  <view class="hero">
    <view class="brand">SynAgent</view>
    <view class="soft">Suki 帮你认识人，也帮你找搭子</view>
  </view>

  <block wx:if="{{mode === 'wechat'}}">
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary" loading="{{busy}}" bindtap="onWeChat">微信登录</button>
    <view class="link terms-line">首次登录需要你确认已年满 18 岁，并同意<text class="under" data-page="terms" catchtap="onLegal">用户协议</text>和<text class="under" data-page="privacy" catchtap="onLegal">隐私政策</text>。</view>
    <view class="link" data-mode="signin" bindtap="onMode">用邮箱登录</view>
  </block>

  <block wx:elif="{{mode === 'signin' || mode === 'signup'}}">
    <input wx:if="{{mode === 'signup'}}" class="input" placeholder="名字" value="{{name}}" data-f="name" bindinput="onInput" />
    <input class="input" placeholder="邮箱" type="text" value="{{email}}" data-f="email" bindinput="onInput" />
    <input class="input" placeholder="{{mode === 'signup' ? '密码（至少 10 位）' : '密码'}}" password="{{true}}" value="{{password}}" data-f="password" bindinput="onInput" />
    <view wx:if="{{mode === 'signup'}}" class="terms">
      <checkbox-group bindchange="onTerms"><checkbox value="yes" /></checkbox-group>
      <view class="grow">我已年满 18 岁，并同意<text class="under" data-page="terms" bindtap="onLegal">用户协议</text>和<text class="under" data-page="privacy" bindtap="onLegal">隐私政策</text>。</view>
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary" loading="{{busy}}" bindtap="onSubmit">{{mode === 'signup' ? '注册' : '登录'}}</button>
    <view class="link" bindtap="onSwitch">{{mode === 'signup' ? '已有账号？去登录' : '没有账号？去注册'}}</view>
    <view wx:if="{{mode === 'signin'}}" class="link" data-mode="forgot" bindtap="onMode">忘记密码</view>
    <view class="link" data-mode="wechat" bindtap="onMode">用微信登录</view>
  </block>

  <block wx:elif="{{mode === 'verify'}}">
    <view class="soft lead">我们给你的邮箱发了验证码。</view>
    <input class="input" placeholder="验证码" value="{{code}}" data-f="code" bindinput="onInput" />
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary" loading="{{busy}}" bindtap="onVerify">验证</button>
    <view class="link" bindtap="onResend">重新发送</view>
    <view class="link" bindtap="onLeave">换个账号</view>
  </block>

  <block wx:elif="{{mode === 'forgot'}}">
    <input class="input" placeholder="邮箱" value="{{email}}" data-f="email" bindinput="onInput" />
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary" loading="{{busy}}" bindtap="onForgot">发送验证码</button>
    <view class="link" data-mode="signin" bindtap="onMode">返回登录</view>
  </block>

  <block wx:elif="{{mode === 'reset'}}">
    <view class="soft lead">如果这个邮箱注册过，验证码已经发出。</view>
    <input class="input" placeholder="验证码" value="{{code}}" data-f="code" bindinput="onInput" />
    <input class="input" placeholder="新密码（至少 10 位）" password="{{true}}" value="{{password}}" data-f="password" bindinput="onInput" />
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary" loading="{{busy}}" bindtap="onReset">重设密码</button>
    <view class="link" data-mode="signin" bindtap="onMode">返回登录</view>
  </block>
</view>
