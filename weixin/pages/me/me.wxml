<view class="page">
  <view class="card">
    <view class="title">{{user.name}}</view>
    <view class="soft">{{user.email}}</view>
    <view class="soft gap">想改资料？直接告诉 Suki。</view>
  </view>

  <view class="section">照片</view>
  <view class="photos">
    <image wx:for="{{photos}}" wx:key="id" class="photo" src="{{item.path}}" mode="aspectFill" data-id="{{item.id}}" bindtap="onPhoto" />
    <view wx:if="{{photos.length < 6}}" class="photo add" bindtap="onAddPhoto">+</view>
  </view>

  <view class="section">积分</view>
  <view class="card" wx:if="{{credits}}">
    <view class="title">还剩 {{credits.balance}} 积分</view>
    <view class="soft" wx:if="{{credits.free}}">现在和 Suki 对话免费。{{credits.free_matches}} 次免费匹配已用 {{credits.matches_used}} 次。</view>
    <view class="soft" wx:else>每条发给 Suki 的消息消耗 {{credits.cost_per_message}} 积分。和匹配对象聊天免费，涉及安全或账号的问题也免费。</view>
    <block wx:if="{{credits.wechat_enabled && packs.length}}">
      <button wx:for="{{packs}}" wx:for-item="p" wx:key="id" class="plain" disabled="{{buying}}" data-id="{{p.id}}" bindtap="onBuy">{{p.label}}</button>
    </block>
    <view wx:elif="{{credits.wechat_enabled}}" class="soft gap">iOS 暂不支持充值。</view>
    <view wx:for="{{usage}}" wx:key="index" class="row gap">
      <view class="grow soft">{{item.text}} · {{item.when}}</view>
      <view>{{item.delta > 0 ? '+' : ''}}{{item.delta}}</view>
    </view>
  </view>

  <view class="section">账号</view>
  <button class="plain" data-page="terms" bindtap="onLegal">复制用户协议链接</button>
  <button class="plain" data-page="privacy" bindtap="onLegal">复制隐私政策链接</button>
  <button class="plain" bindtap="onSignOut">退出登录</button>
  <button class="danger" bindtap="onDelete">删除账号</button>
</view>
