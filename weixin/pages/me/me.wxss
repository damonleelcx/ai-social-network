.photos { display: flex; flex-wrap: wrap; }
.photo-wrap { position: relative; width: 200rpx; height: 200rpx; margin: 0 16rpx 16rpx 0; }
.photo-wrap .photo { margin: 0; display: block; }
.photo { width: 200rpx; height: 200rpx; border-radius: 16rpx; margin: 0 16rpx 16rpx 0; background: rgba(255,255,255,.1); }
.photo-more { position: absolute; right: 8rpx; bottom: 8rpx; width: 60rpx; height: 44rpx; line-height: 44rpx; text-align: center; font-size: 26rpx; color: #fff; background: rgba(27,16,51,.72); border-radius: 22rpx; }
.add { display: flex; align-items: center; justify-content: center; font-size: 60rpx; color: #a99fc4; }
