<view class="page">
  <suki-says wx:if="{{!loaded}}" face="thinking" size="144" dots body="{{t.loading}}" />
  <block wx:if="{{proposals.length}}">
    <view class="section">{{t.introductions}}</view>
    <suki-card wx:for="{{proposals}}" wx:key="proposal_id" card="{{item}}" intro="{{true}}" />
  </block>
  <view wx:if="{{matches.length}}" class="section">{{t.chats}}</view>
  <view wx:for="{{matches}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="onOpen">
    <image wx:if="{{item.photo}}" class="avatar" src="{{item.photo}}" mode="aspectFill" data-index="{{index}}" catchtap="onPhoto" />
    <view wx:else class="avatar"></view>
    <view class="grow">
      <view class="row">
        <view class="title grow ellipsis">{{item.person.display_name}}</view>
        <view wx:if="{{item.unread}}" class="badge">{{item.unread}}</view>
      </view>
      <view wx:if="{{item.activityText}}" class="soft">{{item.activityText}}</view>
      <view class="soft ellipsis">{{item.last_preview || t.sayHi}}</view>
    </view>
  </view>
  <block wx:if="{{guest}}">
    <suki-says face="thinking" size="264" title="{{t.guestTitle}}" body="{{t.guestBody}}" />
    <button class="primary" bindtap="onSignIn">{{t.signIn}}</button>
  </block>
  <suki-says wx:elif="{{loaded && !matches.length && !proposals.length}}" face="thinking" size="264" title="{{t.emptyTitle}}" body="{{t.emptyBody}}" />
</view>
