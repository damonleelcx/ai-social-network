<view class="page">
  <block wx:if="{{proposals.length}}">
    <view class="section">Suki 的介绍</view>
    <suki-card wx:for="{{proposals}}" wx:key="proposal_id" card="{{item}}" />
  </block>
  <view wx:if="{{matches.length}}" class="section">聊天</view>
  <view wx:for="{{matches}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="onOpen">
    <image wx:if="{{item.photo}}" class="avatar" src="{{item.photo}}" mode="aspectFill" />
    <view wx:else class="avatar"></view>
    <view class="grow">
      <view class="row">
        <view class="title grow ellipsis">{{item.person.display_name}}</view>
        <view wx:if="{{item.unread}}" class="badge">{{item.unread}}</view>
      </view>
      <view wx:if="{{item.activity}}" class="soft">搭子：{{item.activity}}</view>
      <view class="soft ellipsis">{{item.last_preview || '打个招呼吧'}}</view>
    </view>
  </view>
  <view wx:if="{{loaded && !matches.length && !proposals.length}}" class="empty">还没有匹配。告诉 Suki 你想认识什么样的人。</view>
</view>
