<view class="chat">
  <scroll-view class="chat-list" scroll-y scroll-into-view="{{bottom}}" scroll-with-animation>
    <view wx:if="{{loaded && !messages.length}}" class="empty">{{t.hello}}</view>
    <block wx:for="{{messages}}" wx:key="seq">
      <view wx:if="{{item.role === 'event'}}" class="note">{{item.body}}</view>
      <view wx:elif="{{item.body}}" class="bubble-row {{item.role === 'user' ? 'mine' : ''}}">
        <view class="bubble">{{item.body}}<view wx:if="{{item.role === 'assistant'}}" class="ai-label">{{t.aiGenerated}}</view></view>
        <view wx:if="{{speaker && item.role === 'assistant'}}" class="speaker {{clip === item.seq ? 'on' : ''}}" aria-role="button" aria-label="{{clip === item.seq ? (phase === 'playing' ? t.stop : t.cancelVoice) : t.hear}}" data-seq="{{item.seq}}" bindtap="onSpeak">{{clip === item.seq ? (phase === 'playing' ? '■' : '…') : '▶'}}</view>
      </view>
      <suki-card wx:for="{{item.cards}}" wx:for-item="card" wx:for-index="i" wx:key="i" card="{{card}}" />
    </block>
    <view wx:if="{{thinking}}" class="note">{{t.thinking}}</view>
    <view id="end" class="end"></view>
  </scroll-view>
  <view wx:if="{{replies.length && !thinking}}" class="chips">
    <view wx:for="{{replies}}" wx:key="*this" class="chip" data-text="{{item}}" bindtap="onReply">{{item}}</view>
  </view>
  <view class="composer">
    <input class="input" placeholder="{{t.placeholder}}" value="{{draft}}" confirm-type="send" adjust-position bindinput="onInput" bindconfirm="onSend" />
    <view class="send" bindtap="onSend">{{t.send}}</view>
  </view>
</view>
