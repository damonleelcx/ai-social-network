.post-scene { display: block; width: 100%; height: 300rpx; border-radius: 20rpx; margin-bottom: 16rpx; }
.plan-actions { display: flex; margin-bottom: 16rpx; }
.plan-action { flex: 1; margin-right: 16rpx; text-align: center; background: #ff5c8a; color: #fff; border-radius: 40rpx; padding: 18rpx 12rpx; font-weight: 600; }
.plan-action:last-child { margin-right: 0; }
.plan-action.plain { background: rgba(255,255,255,.14); }
