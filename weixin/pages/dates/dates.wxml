<view class="page">
  <block wx:if="{{posts.length}}">
    <view class="section">{{t.posts}}</view>
    <view wx:for="{{posts}}" wx:key="id" wx:for-item="post" class="card">
      <view class="title">{{post.kind}}</view>
      <view class="soft">{{post.when}} · {{post.statusText}}</view>
      <view wx:if="{{post.note}}">{{post.note}}</view>
      <block wx:if="{{post.status === 'open'}}">
        <view wx:for="{{post.offers}}" wx:key="created_at" wx:for-item="offer" class="row gap">
          <view class="grow">{{offer.line}}</view>
          <view class="chip" data-post="{{post.id}}" data-user="{{offer.person.user_id}}" data-name="{{offer.person.display_name}}" bindtap="onPick">{{t.pick}}</view>
        </view>
        <view wx:if="{{!post.offers.length}}" class="soft gap">{{t.nobody}}</view>
        <button class="plain" data-id="{{post.id}}" bindtap="onClose">{{t.takeDown}}</button>
      </block>
      <button wx:elif="{{post.match_id}}" class="plain" data-id="{{post.match_id}}" bindtap="onChat">{{t.openChat}}</button>
    </view>
  </block>
  <view wx:if="{{dates.length}}" class="section">{{t.plans}}</view>
  <view wx:for="{{dates}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="onOpen">
    <view class="title">{{item.person.display_name}}</view>
    <view class="soft">{{item.statusText}}<text wx:if="{{item.whenText}}"> · {{item.whenText}}</text></view>
    <view wx:if="{{item.venue}}">{{item.venue.name}}</view>
  </view>
  <view wx:if="{{loaded && !dates.length && !posts.length}}" class="empty">{{t.empty}}</view>
</view>
