<view class="chat">
  <view class="row bar">
    <view class="grow soft ellipsis" bindtap="onPerson">{{barText}}</view>
    <view wx:if="{{!match.activity}}" class="chip" bindtap="onDate">{{t.plan}}</view>
    <view class="chip" bindtap="onMore">{{t.more}}</view>
  </view>
  <scroll-view class="chat-list" scroll-y scroll-into-view="{{bottom}}">
    <block wx:for="{{messages}}" wx:key="seq">
      <view wx:if="{{item.role !== 'text'}}" class="note">{{item.body}}</view>
      <view wx:else class="bubble-row {{item.sender_id === me ? 'mine' : ''}}">
        <view class="bubble">{{item.body}}</view>
      </view>
    </block>
    <view wx:if="{{match.status && match.status !== 'active'}}" class="note">{{t.ended}}</view>
    <view id="end" class="end"></view>
  </scroll-view>
  <view wx:if="{{match.status === 'active'}}" class="composer">
    <input class="input" placeholder="{{placeholder}}" value="{{draft}}" confirm-type="send" adjust-position bindinput="onInput" bindconfirm="onSend" />
    <view class="send" bindtap="onSend">{{t.send}}</view>
  </view>
</view>
