.bar { padding: 12rpx 24rpx; background: #241644; }
.bar .chip { margin: 0 0 0 12rpx; }
.end { height: 2rpx; }
.coach { margin: 12rpx 20rpx 0; padding: 18rpx 20rpx; border-radius: 20rpx; background: rgba(255,92,138,.14); border: 1px solid rgba(255,92,138,.4); font-size: 28rpx; max-height: 45vh; overflow-y: auto; }
.coach-title { font-weight: 600; }
.coach-line { padding: 10rpx 24rpx; font-size: 24rpx; }
.coach-close { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; font-size: 36rpx; color: #a99fc4; flex-shrink: 0; }
.suggestion { margin-top: 12rpx; padding: 12rpx 18rpx; border-radius: 14rpx; background: rgba(255,92,138,.22); color: #ffd0dc; }
.ask-row { padding-top: 8rpx; padding-bottom: 0; }
