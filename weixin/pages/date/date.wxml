<suki-says wx:if="{{!date && error}}" face="pouty" title="{{t.cannotOpen}}" body="{{error}}" />
<suki-says wx:elif="{{!date}}" face="thinking" size="144" dots body="{{t.loading}}" />
<view class="page" wx:else>
  <view class="title link" bindtap="onPerson">{{heading}}</view>
  <suki-says wx:if="{{date.status === 'searching'}}" face="thinking" size="176" dots title="{{t.searchingTitle}}" body="{{t.searching}}" />
  <suki-says wx:if="{{date.status === 'completed'}}" face="happy" size="216" title="{{askHow}}">
    <button class="primary" bindtap="onTellSuki">{{t.tellSuki}}</button>
  </suki-says>
  <suki-says wx:if="{{date.status === 'failed'}}" face="pouty" size="216" title="{{t.failed}}" body="{{t.failedBody}}">
    <button class="plain" bindtap="onBackToChat">{{t.backToChat}}</button>
  </suki-says>

  <block wx:if="{{date.status === 'voting'}}">
    <view class="section">{{t.pickPlace}}<text wx:if="{{date.other_voted}}"> {{t.otherVoted}}</text></view>
    <view wx:for="{{date.venues}}" wx:key="id" class="card">
      <view class="title">{{item.name}}</view>
      <view class="soft">{{item.address}}</view>
      <view wx:if="{{item.reason}}" class="with-suki">
        <suki-avatar mood="happy" size="52" ring="3" />
        <view class="grow">{{item.reason}}</view>
      </view>
      <view wx:if="{{date.my_vote === item.id}}" class="soft gap">{{t.yourPick}}</view>
      <button wx:else class="plain" data-id="{{item.id}}" bindtap="onVote">{{t.vote}}</button>
    </view>
  </block>

  <view wx:if="{{date.venue}}" class="card gap">
    <view class="title">{{date.venue.name}}</view>
    <view class="soft">{{date.venue.address}}</view>
  </view>

  <block wx:if="{{date.status === 'scheduling'}}">
    <view wx:if="{{proposedText}}" class="card">
      <view class="soft">{{date.proposed_by_me ? t.youSuggested : otherSuggested}}</view>
      <view class="title">{{proposedText}}</view>
      <view wx:if="{{date.proposed_by_me}}" class="soft">{{waiting}}</view>
      <button wx:else class="primary" bindtap="onConfirm">{{t.thatWorks}}</button>
    </view>
    <view class="section">{{proposedText ? t.differentTime : t.suggestTime}}</view>
    <view class="card">
      <picker mode="date" start="{{today}}" value="{{day}}" bindchange="onDay"><view class="input">{{t.day}}: {{day || t.choose}}</view></picker>
      <picker mode="time" value="{{clock}}" bindchange="onClock"><view class="input">{{t.time}}: {{clock || t.choose}}</view></picker>
      <button class="primary" disabled="{{!day || !clock}}" bindtap="onTime">{{t.suggest}}</button>
    </view>
  </block>

  <view wx:if="{{date.status === 'confirmed'}}" class="card">
    <view class="soft">{{t.confirmed}}</view>
    <view class="title">{{scheduledText}}</view>
    <button class="plain" bindtap="onShare">{{t.copyPlan}}</button>
  </view>

  <button wx:if="{{date.status !== 'cancelled' && date.status !== 'completed' && date.status !== 'failed'}}" class="danger" bindtap="onCancel">{{t.cancel}}</button>
  <suki-says wx:if="{{date.status === 'cancelled'}}" face="pouty" size="216" title="{{t.cancelled}}" body="{{t.cancelledBody}}" />
</view>
