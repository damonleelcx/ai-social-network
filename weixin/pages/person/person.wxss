.hero { width: 100%; height: 860rpx; background: rgba(255,255,255,.08); }
.hero-photo { width: 100%; height: 100%; display: block; }
.name { font-size: 44rpx; font-weight: 700; }
.chips-row { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.detail { display: flex; padding: 8rpx 0; }
.detail-key { width: 190rpx; flex-shrink: 0; }
.with-bar { padding-bottom: 170rpx; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background: #241644; }
.bar .half { flex: 1; margin: 0 8rpx !important; width: auto !important; }
