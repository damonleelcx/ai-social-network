<view wx:if="{{gone}}" class="card"><view class="soft">{{t.gone}}</view></view>

<view wx:elif="{{card.kind === 'buddy_post'}}" class="card">
  <view class="title">{{activityText}}</view>
  <view class="soft">{{card.when}}<text wx:if="{{groupText}}"> · {{groupText}}</text></view>
  <view wx:if="{{placeText}}" class="soft">{{placeText}}</view>
  <view wx:if="{{card.note}}">{{card.note}}</view>
  <view wx:if="{{groupText}}" class="soft">{{t.groupHint}}</view>
  <view wx:if="{{state === 'done'}}" class="done">{{t.posted}}</view>
  <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onPost">{{t.post}}</button>
</view>

<view wx:elif="{{card.kind === 'buddy_request' && item}}" class="card">
  <view class="row">
    <image wx:if="{{photo}}" class="avatar" src="{{photo}}" mode="aspectFill" bindtap="onPreview" />
    <view class="grow">
      <view class="title">{{activityText}}</view>
      <view class="soft">{{item.person.display_name}} · {{item.when}}</view>
      <view wx:if="{{groupText}}" class="soft">{{groupText}}</view>
    </view>
  </view>
  <view wx:if="{{placeText}}" class="soft">{{placeText}}</view>
  <view wx:if="{{item.note}}">{{item.note}}</view>
  <block wx:if="{{item.spots > 1}}">
    <block wx:if="{{item.offered || item.joined}}">
      <button class="primary" bindtap="onOpenGroup">{{t.openGroup}}</button>
      <button wx:if="{{item.offered}}" class="plain" loading="{{state === 'busy'}}" bindtap="onOffer">{{t.leaveGroup}}</button>
    </block>
    <view wx:elif="{{item.status !== 'open'}}" class="soft">{{t.gone}}</view>
    <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onOffer">{{t.joinGroup}}</button>
  </block>
  <view wx:elif="{{item.status !== 'open'}}" class="soft">{{t.gone}}</view>
  <button wx:elif="{{item.offered}}" class="plain" loading="{{state === 'busy'}}" bindtap="onOffer">{{t.takeBack}}</button>
  <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onOffer">{{t.imIn}}</button>
</view>

<view wx:elif="{{card.kind === 'group' && item}}" class="card">
  <view class="title">{{activityText}}</view>
  <view class="soft">{{item.when}}<text wx:if="{{groupText}}"> · {{groupText}}</text></view>
  <view wx:if="{{placeText}}" class="soft">{{placeText}}</view>
  <button class="primary" bindtap="onOpenGroup">{{t.openGroup}}</button>
</view>

<view wx:elif="{{card.kind === 'trip_post'}}" class="card">
  <view class="title">✈ {{state === 'done' && item ? item.city_name : card.city}}</view>
  <view class="soft">{{datesText}}</view>
  <view wx:if="{{card.note}}">{{card.note}}</view>
  <view wx:if="{{state === 'done'}}" class="done">{{tripText}}</view>
  <block wx:else>
    <view class="soft">{{t.tripHint}}</view>
    <button class="primary" loading="{{state === 'busy'}}" bindtap="onAddTrip">{{t.addTrip}}</button>
  </block>
</view>

<view wx:elif="{{card.kind === 'trip' && item}}" class="card">
  <view class="title">✈ {{item.city_name}}</view>
  <view class="soft">{{datesText}}</view>
  <view wx:if="{{item.note}}">{{item.note}}</view>
  <view class="soft">{{tripText}}</view>
</view>

<view wx:elif="{{card.kind === 'buddy_offer' && item && item.person}}" class="card">
  <view class="row">
    <image wx:if="{{photo}}" class="avatar" src="{{photo}}" mode="aspectFill" bindtap="onPreview" />
    <view class="grow">
      <view class="title">{{offerLine}}</view>
      <view class="soft">{{activityText}} · {{item.when}}</view>
    </view>
  </view>
  <view wx:if="{{state === 'done' || item.status !== 'open'}}" class="done">{{t.picked}}</view>
  <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onPick">{{t.pick}}</button>
</view>

<view wx:elif="{{card.kind === 'proposal' && item}}" class="card">
  <view class="row">
    <image wx:if="{{photo}}" class="avatar" src="{{photo}}" mode="aspectFill" bindtap="onPreview" />
    <view class="grow" bindtap="onProfile">
      <view class="title">{{item.person.display_name}} · {{item.person.age}}</view>
      <view class="soft">{{item.person.city_name}}</view>
      <view class="link">{{t.profile}} ›</view>
    </view>
  </view>
  <view wx:if="{{intro}}" class="with-suki">
    <suki-avatar mood="playful" size="64" />
    <view class="grow pitch">{{item.pitch}}</view>
  </view>
  <view wx:else>{{item.pitch}}</view>
  <block wx:if="{{item.status === 'open' && !state}}">
    <button class="primary" data-decision="accept" bindtap="onDecide">{{t.like}}</button>
    <button class="plain" data-decision="pass" bindtap="onDecide">{{t.pass}}</button>
  </block>
  <view wx:elif="{{state === 'busy'}}" class="soft">{{t.moment}}</view>
  <view wx:else class="done">{{t.answered}}</view>
</view>

<view wx:elif="{{card.kind === 'match'}}" class="card">
  <button class="primary" bindtap="onOpenMatch">{{t.openChat}}</button>
</view>

<view wx:elif="{{card.kind === 'date'}}" class="card">
  <button class="primary" bindtap="onOpenDate">{{card.focus === 'time' ? t.pickTime : card.focus === 'change' ? t.changePlan : t.seePlan}}</button>
</view>

<view wx:elif="{{card.kind === 'share_plan'}}" class="card">
  <view class="soft">{{t.tellFriend}}</view>
  <button class="plain" bindtap="onShare">{{t.copyPlan}}</button>
</view>

<view wx:elif="{{card.kind === 'open_screen' && card.screen !== 'verify_email'}}" class="card">
  <button class="plain" bindtap="onOpenScreen">{{card.label}}</button>
</view>

<view wx:elif="{{card.kind === 'bio_draft'}}" class="card">
  <view>{{card.text}}</view>
  <view wx:if="{{state === 'done'}}" class="done">{{t.updated}}</view>
  <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onBio">{{t.useThis}}</button>
</view>

<view wx:elif="{{card.kind === 'photo_upload'}}" class="card">
  <view wx:if="{{state === 'done'}}" class="done">{{t.photoIn}}</view>
  <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onPhoto">{{t.addPhoto}}</button>
</view>

<view wx:elif="{{card.kind === 'buy_credits' && item}}" class="card">
  <view class="title">{{balanceText}}</view>
  <block wx:if="{{item.wechat_enabled && packs.length}}">
    <button wx:for="{{packs}}" wx:for-item="p" wx:key="id" class="plain" disabled="{{state === 'busy'}}" data-id="{{p.id}}" bindtap="onBuy">{{p.label}}</button>
  </block>
  <view wx:else class="soft">{{t.noBuying}}</view>
</view>

<view wx:elif="{{card.kind === 'confirm'}}" class="card">
  <view wx:if="{{state === 'done'}}" class="done">{{t.done}}</view>
  <button wx:else class="danger" loading="{{state === 'busy'}}" bindtap="onConfirm">{{confirmLabel}}</button>
</view>

<view wx:if="{{error}}" class="error">{{error}}</view>
