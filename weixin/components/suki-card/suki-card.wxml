<view wx:if="{{gone}}" class="card"><view class="soft">{{t.gone}}</view></view>

<view wx:elif="{{card.kind === 'buddy_post'}}" class="card {{scene ? 'hero-card' : ''}}">
  <image wx:if="{{scene}}" class="scene-strip" src="{{scene}}" mode="aspectFill" binderror="onSceneError" />
  <view wx:if="{{scene}}" class="scene-ai">{{t.aiGenerated}}</view>
  <view class="{{scene ? 'hero-body' : ''}}">
  <view class="title">{{activityText}}</view>
  <view class="soft">{{card.when}}<text wx:if="{{groupText}}"> · {{groupText}}</text></view>
  <view wx:if="{{placeText}}" class="soft">{{placeText}}</view>
  <view wx:if="{{card.note}}">{{card.note}}</view>
  <view wx:if="{{groupText}}" class="soft">{{t.groupHint}}</view>
  <view wx:if="{{state === 'done'}}" class="done">{{t.posted}}</view>
  <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onPost">{{t.post}}</button>
  </view>
</view>

<view wx:elif="{{card.kind === 'buddy_request' && item}}" class="card hero-card">
  <view class="hero" bindtap="onPreview">
    <image wx:if="{{scene || photo}}" class="hero-img" src="{{scene || photo}}" mode="aspectFill" />
    <view wx:else class="hero-img hero-empty"></view>
    <view class="hero-shade"></view>
    <view class="hero-badges"><text wx:if="{{scene}}" class="badge">{{t.aiGenerated}}</text><text wx:if="{{item.person.verified}}" class="badge">✓ {{t.verified}}</text><text class="badge">{{activityText}}</text><text wx:if="{{groupText}}" class="badge">{{groupText}}</text></view>
    <view class="hero-text hero-row">
      <image wx:if="{{scene && photo}}" class="hero-avatar" src="{{photo}}" mode="aspectFill" />
      <view class="grow">
      <view class="hero-title">{{heroTitle}}</view>
      <view wx:if="{{heroLine}}" class="hero-line">{{heroLine}}</view>
      </view>
    </view>
  </view>
  <view class="hero-body">
    <view class="title">{{item.when}}</view>
    <view wx:if="{{placeText}}" class="soft">{{placeText}}</view>
    <view wx:if="{{item.note}}">{{item.note}}</view>
    <block wx:if="{{item.spots > 1}}">
      <block wx:if="{{item.offered || item.joined}}">
        <button class="primary" bindtap="onOpenGroup">{{t.openGroup}}</button>
        <button wx:if="{{item.offered}}" class="plain" loading="{{state === 'busy'}}" bindtap="onOffer">{{t.leaveGroup}}</button>
      </block>
      <view wx:elif="{{item.status !== 'open'}}" class="soft">{{t.gone}}</view>
      <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onOffer">{{t.joinGroup}}</button>
    </block>
    <view wx:elif="{{item.status !== 'open'}}" class="soft">{{t.gone}}</view>
    <button wx:elif="{{item.offered}}" class="plain" loading="{{state === 'busy'}}" bindtap="onOffer">{{t.takeBack}}</button>
    <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onOffer">{{t.imIn}}</button>
  </view>
</view>

<view wx:elif="{{card.kind === 'group' && item}}" class="card {{scene ? 'hero-card' : ''}}">
  <image wx:if="{{scene}}" class="scene-strip" src="{{scene}}" mode="aspectFill" />
  <view wx:if="{{scene}}" class="scene-ai">{{t.aiGenerated}}</view>
  <view class="{{scene ? 'hero-body' : ''}}">
  <view class="title">{{activityText}}</view>
  <view class="soft">{{item.when}}<text wx:if="{{groupText}}"> · {{groupText}}</text></view>
  <view wx:if="{{placeText}}" class="soft">{{placeText}}</view>
  <button class="primary" bindtap="onOpenGroup">{{t.openGroup}}</button>
  </view>
</view>

<view wx:elif="{{card.kind === 'looking_for' && looking}}" class="card">
  <view class="title">{{t.lookingTitle}}</view>
  <view class="soft">{{t.lookingHint}}</view>
  <view class="lf-head">{{t.must}}</view>
  <view wx:if="{{!looking.must.length}}" class="soft">{{t.nothingYet}}</view>
  <view wx:for="{{looking.must}}" wx:key="*this" class="lf-line">{{item}}</view>
  <view class="lf-head">{{t.drawnTo}}</view>
  <view wx:if="{{!looking.toward.length}}" class="soft">{{t.nothingYet}}</view>
  <view wx:for="{{looking.toward}}" wx:key="id" class="lf-line row lf-read"><view class="grow"><view>{{item.text}}</view><view class="lf-said">“{{item.said}}”</view></view><view class="lf-x" data-id="{{item.id}}" bindtap="onDropRead">✕</view></view>
  <view class="lf-head">{{t.steerClear}}</view>
  <view wx:if="{{!looking.flags.length && !looking.away.length}}" class="soft">{{t.nothingYet}}</view>
  <view wx:for="{{looking.away}}" wx:key="id" class="lf-line row lf-read"><view class="grow"><view>{{item.text}}</view><view class="lf-said">“{{item.said}}”</view></view><view class="lf-x" data-id="{{item.id}}" bindtap="onDropRead">✕</view></view>
  <view wx:for="{{looking.flags}}" wx:key="field" class="lf-line row"><view class="grow">{{item.text}}</view><view class="lf-x" data-field="{{item.field}}" bindtap="onDropFlag">✕</view></view>
  <view class="lf-head">{{t.nice}}</view>
  <view wx:if="{{!looking.nice.length}}" class="soft">{{t.nothingYet}}</view>
  <view wx:for="{{looking.nice}}" wx:key="id" class="lf-line row"><view class="grow">{{item.note}}</view><view class="lf-x" data-id="{{item.id}}" bindtap="onDropNote">✕</view></view>
  <button class="plain" bindtap="onChangeLooking">{{t.changeSomething}}</button>
</view>

<view wx:elif="{{card.kind === 'selfie'}}" class="card">
  <view class="title">{{t.selfieTitle}}</view>
  <view class="soft">{{t.selfieHint}}</view>
  <view wx:if="{{state === 'done'}}" class="done">{{t.verifiedNow}}</view>
  <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onSelfie">{{t.takeSelfie}}</button>
</view>

<view wx:elif="{{card.kind === 'invite'}}" class="card">
  <view class="soft">{{t.inviteLine}}</view>
  <button class="primary" open-type="share">{{t.sendInvite}}</button>
  <button class="plain" bindtap="onPoster">{{t.momentsPoster}}</button>
</view>

<view wx:elif="{{card.kind === 'trip_post'}}" class="card {{scene ? 'hero-card' : ''}}">
  <image wx:if="{{scene}}" class="scene-strip" src="{{scene}}" mode="aspectFill" binderror="onSceneError" />
  <view wx:if="{{scene}}" class="scene-ai">{{t.aiGenerated}}</view>
  <view class="{{scene ? 'hero-body' : ''}}">
  <view class="title">✈ {{state === 'done' && item ? item.city_name : card.city}}</view>
  <view class="soft">{{datesText}}</view>
  <view wx:if="{{card.note}}">{{card.note}}</view>
  <view wx:if="{{state === 'done'}}" class="done">{{tripText}}</view>
  <block wx:else>
    <view class="soft">{{t.tripHint}}</view>
    <button class="primary" loading="{{state === 'busy'}}" bindtap="onAddTrip">{{t.addTrip}}</button>
  </block>
  </view>
</view>

<view wx:elif="{{card.kind === 'trip' && item}}" class="card {{scene ? 'hero-card' : ''}}">
  <image wx:if="{{scene}}" class="scene-strip" src="{{scene}}" mode="aspectFill" />
  <view wx:if="{{scene}}" class="scene-ai">{{t.aiGenerated}}</view>
  <view class="{{scene ? 'hero-body' : ''}}">
  <view class="title">✈ {{item.city_name}}</view>
  <view class="soft">{{datesText}}</view>
  <view wx:if="{{item.note}}">{{item.note}}</view>
  <view class="soft">{{tripText}}</view>
  </view>
</view>

<view wx:elif="{{card.kind === 'buddy_offer' && item && item.person}}" class="card hero-card">
  <view class="hero" bindtap="onPreview">
    <image wx:if="{{photo}}" class="hero-img" src="{{photo}}" mode="aspectFill" />
    <view wx:else class="hero-img hero-empty"></view>
    <view class="hero-shade"></view>
    <view class="hero-badges"><text class="badge">{{t.wantsToJoin}}</text></view>
    <view class="hero-text">
      <view class="hero-title">{{heroTitle}}</view>
      <view wx:if="{{heroLine}}" class="hero-line">{{heroLine}}</view>
    </view>
  </view>
  <view class="hero-body">
    <view class="title">{{activityText}} · {{item.when}}</view>
    <view wx:if="{{state === 'done' || item.status !== 'open'}}" class="done">{{t.picked}}</view>
    <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onPick">{{t.pick}}</button>
  </view>
</view>

<view wx:elif="{{card.kind === 'proposal' && item}}" class="card hero-card">
  <view class="hero" bindtap="onProfile">
    <image wx:if="{{photo}}" class="hero-img" src="{{photo}}" mode="aspectFill" />
    <view wx:else class="hero-img hero-empty"></view>
    <view class="hero-shade"></view>
    <view class="hero-badges"><text class="badge">{{t.recommends}}</text><text wx:if="{{item.person.verified}}" class="badge">✓ {{t.verified}}</text></view>
    <view class="hero-text">
      <view class="hero-title">{{heroTitle}}</view>
      <view wx:if="{{heroLine}}" class="hero-line">{{heroLine}}</view>
    </view>
  </view>
  <view class="hero-body">
    <view wx:if="{{intro}}" class="with-suki">
      <suki-avatar mood="playful" size="64" />
      <view class="grow pitch">{{item.pitch}}</view>
    </view>
    <view wx:else class="pitch-quote">{{item.pitch}}</view>
    <view class="link" bindtap="onProfile">{{t.profile}} ›</view>
    <button wx:if="{{item.status === 'open' && !state}}" class="plain" bindtap="onAsk">{{askLabel}}</button>
    <block wx:if="{{item.status === 'open' && !state}}">
      <button class="primary" data-decision="accept" bindtap="onDecide">{{t.like}}</button>
      <button class="plain" data-decision="pass" bindtap="onDecide">{{t.pass}}</button>
    </block>
    <view wx:elif="{{state === 'busy'}}" class="soft">{{t.moment}}</view>
    <view wx:else class="done">{{t.answered}}</view>
  </view>
</view>

<view wx:elif="{{card.kind === 'match'}}" class="card">
  <button class="primary" bindtap="onOpenMatch">{{t.openChat}}</button>
</view>

<view wx:elif="{{card.kind === 'date'}}" class="card">
  <button class="primary" bindtap="onOpenDate">{{card.focus === 'time' ? t.pickTime : card.focus === 'change' ? t.changePlan : t.seePlan}}</button>
</view>

<view wx:elif="{{card.kind === 'share_plan'}}" class="card">
  <view class="soft">{{t.tellFriend}}</view>
  <button class="plain" bindtap="onShare">{{t.copyPlan}}</button>
</view>

<view wx:elif="{{card.kind === 'open_screen' && card.screen !== 'verify_email'}}" class="card">
  <button class="plain" bindtap="onOpenScreen">{{card.label}}</button>
</view>

<view wx:elif="{{card.kind === 'bio_draft'}}" class="card">
  <view>{{card.text}}</view>
  <view wx:if="{{state === 'done'}}" class="done">{{t.updated}}</view>
  <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onBio">{{t.useThis}}</button>
</view>

<view wx:elif="{{card.kind === 'photo_upload'}}" class="card">
  <view wx:if="{{state === 'done'}}" class="done">{{t.photoIn}}</view>
  <button wx:else class="primary" loading="{{state === 'busy'}}" bindtap="onPhoto">{{t.addPhoto}}</button>
</view>

<view wx:elif="{{card.kind === 'buy_credits' && item}}" class="card">
  <view class="title">{{balanceText}}</view>
  <block wx:if="{{item.wechat_enabled && packs.length}}">
    <view class="soft">{{t.buyNotice}}</view>
    <button wx:for="{{packs}}" wx:for-item="p" wx:key="id" class="plain" disabled="{{state === 'busy'}}" data-id="{{p.id}}" bindtap="onBuy">{{p.label}}</button>
  </block>
  <view wx:else class="soft">{{t.noBuying}}</view>
</view>

<view wx:elif="{{card.kind === 'confirm'}}" class="card">
  <view wx:if="{{state === 'done'}}" class="done">{{t.done}}</view>
  <button wx:else class="danger" loading="{{state === 'busy'}}" bindtap="onConfirm">{{confirmLabel}}</button>
</view>

<view wx:if="{{error}}" class="error">{{error}}</view>
